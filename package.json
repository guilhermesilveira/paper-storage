{
  "name": "paper-storage",
  "version": "0.1.0",
  "description": "Standalone CLI and library for storing, indexing, extracting, and retrieving papers.",
  "keywords": [
    "papers",
    "pdf",
    "cli",
    "research"
  ],
  "license": "MIT",
  "author": "Guilherme Silveira <guilherme.silveira@alura.com.br>",
  "homepage": "https://github.com/guilhermesilveira/paper-storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesilveira/paper-storage.git"
  },
  "bugs": {
    "url": "https://github.com/guilhermesilveira/paper-storage/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paper-storage": "./dist/bin/paper-storage.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.6.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.1"
  }
}
